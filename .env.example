# Copy to .env. Every value below is a default — the platform boots with none of
# this set, using mock providers and no GPU.

VAANI_ENV=dev
VAANI_HOST=0.0.0.0
VAANI_PORT=8080
VAANI_LOG_LEVEL=INFO
VAANI_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Tier 1 — laptop demo. No models, no GPU, no infrastructure. This is default.
# ---------------------------------------------------------------------------
VAANI_STT_PROVIDER=mock
VAANI_LLM_PROVIDER=mock
VAANI_TTS_PROVIDER=mock
VAANI_VECTOR_STORE=memory
VAANI_EMBEDDING_PROVIDER=hash

# ---------------------------------------------------------------------------
# Tier 2 — real AI on one workstation (RTX 4090 class).
#   pip install -e ".[ai,rag]"
#   ollama pull qwen2.5:7b-instruct
#   bash scripts/fetch_voices.sh
# ---------------------------------------------------------------------------
# VAANI_STT_PROVIDER=faster_whisper
# VAANI_STT_MODEL=small              # tiny|base|small|medium|large-v3
# VAANI_STT_DEVICE=auto
# VAANI_STT_LANGUAGE=                # blank = auto-detect per utterance

# VAANI_LLM_PROVIDER=openai_compat
# VAANI_LLM_BASE_URL=http://localhost:11434/v1   # Ollama; vLLM is :8000/v1
# VAANI_LLM_MODEL=qwen2.5:7b-instruct
# VAANI_LLM_TEMPERATURE=0.3
# VAANI_LLM_MAX_TOKENS=512

# VAANI_TTS_PROVIDER=piper
# VAANI_TTS_VOICE=en_US-lessac-medium
# VAANI_TTS_VOICES_DIR=./models/piper

# VAANI_EMBEDDING_PROVIDER=sentence_transformers
# VAANI_EMBEDDING_MODEL=BAAI/bge-m3
# VAANI_VECTOR_STORE=qdrant
# VAANI_QDRANT_URL=http://localhost:6333

# ---------------------------------------------------------------------------
# Tier 3 — production cluster.
# ---------------------------------------------------------------------------
# VAANI_ENV=prod
# VAANI_CORS_ORIGINS=https://admin.example.gov.in
# VAANI_DATABASE_URL=postgresql+asyncpg://vaani:CHANGEME@postgres:5432/vaani
# VAANI_REDIS_URL=redis://redis:6379/0
# VAANI_STT_MODEL=large-v3
# VAANI_LLM_MODEL=Qwen/Qwen2.5-72B-Instruct
# VAANI_MAX_CONCURRENT_CALLS=200

# ---------------------------------------------------------------------------
# Conversation feel. These are the numbers you will actually tune in a pilot.
# ---------------------------------------------------------------------------
# Trailing silence that ends a caller's turn. Lower = snappier but interrupts
# people who pause to think. 500-900 is the usable range.
VAANI_END_OF_TURN_SILENCE_MS=700
# Continuous caller speech required to cut the agent off mid-sentence.
VAANI_BARGE_IN_MS=240
# How far ahead of real time agent audio may be sent.
VAANI_PLAYOUT_LEAD_MS=300
VAANI_IDLE_PROMPT_AFTER_S=8
VAANI_IDLE_HANGUP_AFTER_S=25
VAANI_MAX_CALL_DURATION_S=900
VAANI_MAX_CONCURRENT_CALLS=50

VAANI_RECORD_CALLS=true
VAANI_RECORDINGS_DIR=./data/recordings
